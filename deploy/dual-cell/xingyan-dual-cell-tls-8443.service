[Unit]
Description=Xingyan dual-cell live TLS entry on 8443
After=network-online.target xingyan-dual-cell-a@0.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/xingyan-dual-cell/gateway-8443.env
ExecStart=/opt/node24/bin/node /opt/xingyan-dual-cell/release-r1/tools/dual-cell-tls-proxy.js
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
LimitNOFILE=200000
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
