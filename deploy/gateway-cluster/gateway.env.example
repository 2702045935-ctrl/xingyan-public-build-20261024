# 每个 Gateway 实例复制一份，修改 GATEWAY_PORT/GATEWAY_NODE_ID
GATEWAY_PORT=5290
GATEWAY_HOST=0.0.0.0
GATEWAY_NODE_ID=gateway-a
GATEWAY_CELL_ID=cell-a
GATEWAY_FAILURE_DOMAIN=provider-a-zone-a

# 主服务内部上游；生产使用内网地址
GATEWAY_UPSTREAM_WS=ws://127.0.0.1:5180/__gateway/upstream
GATEWAY_BACKEND_HTTP=http://127.0.0.1:5180

# 与主服务一致；不要提交真实值
GATEWAY_ADMIN_SECRET=change-me-in-secret-store

GATEWAY_HEARTBEAT_MS=10000
WS_MAX_TOTAL_CONNECTIONS=100000
WS_MAX_CONNECTIONS_PER_USER=4
WS_MAX_CONNECTIONS_PER_IP=60
WS_SOFT_LOAD_RATIO=0.85

# 集群切换 ownership 时改为 etcd；单机本地调试保持 local
GATEWAY_SESSION_BACKEND=local
GATEWAY_SESSION_LEASE_MS=90000
GATEWAY_SESSION_RENEW_MS=30000
GATEWAY_SESSION_RENEW_BATCH=500
