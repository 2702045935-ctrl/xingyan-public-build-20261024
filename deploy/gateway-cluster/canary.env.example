# 主服务环境：先只打开 canary，不要直接 live
GATEWAY_DIRECTORY_BACKEND=etcd
ETCD_URL=http://127.0.0.1:2379
ETCD_GATEWAY_PREFIX=/xingyan/gateways
ETCD_SESSION_PREFIX=/xingyan/gateway-sessions
ETCD_GATEWAY_SESSION_TTL=90
GATEWAY_SESSION_BACKEND=etcd
GATEWAY_FANOUT_MODE=canary
GATEWAY_FANOUT_CANARY_PERCENT=1
GATEWAY_FANOUT_TIMEOUT_MS=2500
GATEWAY_FANOUT_RETRIES=1
GATEWAY_CANARY_MAX_FAILURE_RATIO=0.05
GATEWAY_CANARY_MAX_PENDING=5000
FANOUT_FLUSH_MS=500

# 下发给客户端的公共 WebSocket 入口（不要带 wss://）
GATEWAY_PUBLIC_WS=gw.example.com:443
