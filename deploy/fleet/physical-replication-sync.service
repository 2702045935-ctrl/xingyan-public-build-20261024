[Unit]
Description=Xingyan physical shard replication from current fleet plan
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/xingyan-dual-cell/replication.env
ExecStart=/opt/node24/bin/node /opt/xingyan-dual-cell/release-r1/deploy/fleet/fleet-replication-sync.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run/xingyan-fleet-replication /opt/xingyan-dual-cell/physical-r1
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
