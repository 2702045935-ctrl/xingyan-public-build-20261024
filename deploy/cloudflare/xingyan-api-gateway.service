[Unit]
Description=Xingyan API gateway for the trusted public ingress
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/xingyan-api-gateway/gateway.env
ExecStart=/opt/xingyan-isolated-test/runtime/bin/node /opt/xingyan-api-gateway/gateway.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/xingyan-api-gateway

[Install]
WantedBy=multi-user.target
